# Адрес, на который сайт отправляет новых подписчиков (JSON POST: email, source, consent, at).
# Задаётся в Vercel: Project → Settings → Environment Variables. В репозиторий не добавлять.
SUBSCRIBE_WEBHOOK_URL=

# PostgreSQL (Neon, Supabase, Vercel Postgres или свой сервер)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME?sslmode=require
# Только для первого запуска seed: создаст администратора. Пароль не короче 12 символов, в репозиторий не попадает.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Временный админ-вход (/admin/login). Значения задаёт только владелец, в репозиторий не попадают.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
# Секрет подписи cookie сессии, не короче 32 символов. Сгенерировать: openssl rand -base64 48
ADMIN_SESSION_SECRET=7FWXTpmJVdtJgHt7bKQW9A8NsC1e6GE1JVq08iAW0+qpfQR+qAfxDqkVeMc5ZDAH

# Постоянное хранилище админки (Upstash Redis через Vercel Marketplace или upstash.com). Без него данные временные.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# GetCourse (подготовка к интеграции; сейчас только проверка наличия)
GETCOURSE_ACCOUNT=
GETCOURSE_API_KEY=
